{
  "name": "imgxplorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "check": "svelte-check --tsconfig ui/tsconfig.json",
    "wasm": "wasm-pack build crates/imgx-wasm --target web --out-dir ../../ui/src/lib/wasm/pkg --out-name imgx",
    "tauri": "tauri",
    "dist": "bash packaging/dist.sh all",
    "dist:linux": "bash packaging/dist.sh linux",
    "dist:mac": "bash packaging/dist.sh mac"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-log": "^2.10.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.7"
  }
}
