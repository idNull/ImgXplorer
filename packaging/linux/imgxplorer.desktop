[Desktop Entry]
Type=Application
Name=imgxplorer
GenericName=Image and comic viewer
GenericName[es]=Visor de imágenes y cómics
Comment=View images and comics, animate the camera and export videos
Comment[es]=Ve imágenes y cómics, anima la cámara y exporta vídeos
Exec=imgxplorer %f
Icon=imgxplorer
Terminal=false
Categories=Graphics;Viewer;2DGraphics;
Keywords=image;comic;cbz;cbr;viewer;manga;video;
MimeType=application/vnd.comicbook+zip;application/vnd.comicbook-rar;application/x-cbz;application/x-cbr;application/x-cb7;image/jpeg;image/png;image/webp;image/avif;image/heif;image/heic;image/jxl;image/gif;image/tiff;inode/directory;
StartupWMClass=imgxplorer
