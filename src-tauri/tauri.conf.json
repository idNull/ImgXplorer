{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "imgxplorer",
  "version": "0.1.0",
  "identifier": "com.imgxplorer.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "imgxplorer",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 320,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' imgx: http://imgx.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost imgx: http://imgx.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "dmg", "app"],
    "category": "Graphics",
    "shortDescription": "Visor de imágenes y cómics con animaciones de cámara",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
