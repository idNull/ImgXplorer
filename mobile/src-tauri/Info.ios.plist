<?xml version="1.0" encoding="UTF-8"?>
<!-- Lo que Tauri añade al Info.plist de iOS (gen/apple). Tipos de archivo: así imgxplorer sale en
     «Abrir con» / «Compartir» (Archivos, WhatsApp, Telegram…) para cómics, historias e imágenes.
     iOS copia lo abierto a Documents/Inbox (LSSupportsOpeningDocumentsInPlace = NO): la app no
     toca el original. Ver mobile/README_iOS.md. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Historia de imgxplorer</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.imgxplorer.story</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Cómic</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.imgxplorer.cbz</string>
				<string>com.imgxplorer.cbr</string>
				<string>com.imgxplorer.cb7</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Imagen</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.imgxplorer.story</string>
			<key>UTTypeDescription</key>
			<string>Historia de imgxplorer</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>imgxstory</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-imgxstory</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.imgxplorer.cbz</string>
			<key>UTTypeDescription</key>
			<string>Cómic (CBZ)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cbz</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.comicbook+zip</string>
					<string>application/x-cbz</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.imgxplorer.cbr</string>
			<key>UTTypeDescription</key>
			<string>Cómic (CBR)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cbr</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.comicbook-rar</string>
					<string>application/x-cbr</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.imgxplorer.cb7</string>
			<key>UTTypeDescription</key>
			<string>Cómic (CB7)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cb7</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-cb7</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
