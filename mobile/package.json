{
  "name": "imgxplorer-mobile",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "imgxplorer para el móvil (visor). Usa las dependencias de Node del proyecto raíz.",
  "scripts": {
    "dev": "../node_modules/.bin/vite --config ui/vite.config.ts",
    "build": "../node_modules/.bin/vite build --config ui/vite.config.ts",
    "check": "../node_modules/.bin/svelte-check --tsconfig ui/tsconfig.json",
    "tauri": "TAURI_APP_PATH=src-tauri TAURI_FRONTEND_PATH=. ../node_modules/.bin/tauri",
    "desktop": "TAURI_APP_PATH=src-tauri TAURI_FRONTEND_PATH=. ../node_modules/.bin/tauri dev",
    "android": "bash scripts/android.sh",
    "ios": "TAURI_APP_PATH=src-tauri TAURI_FRONTEND_PATH=. ../node_modules/.bin/tauri ios"
  }
}
